using System;
using System.Windows.Forms;
using Microsoft.VisualBasic;

namespace MateoGuapo
{
    public partial class Form1 : Form
    {
        // Guarda las 9 ventas.
        int[,] ventas = new int[3, 3];

        public Form1()
        {
            InitializeComponent();
        }

        // Al abrir, oculta el botón de imprimir.
        private void Form1_Load(object sender, EventArgs e)
        {
            button2.Visible = false;
        }

        // BOTÓN 1: captura las ventas.
        private void button1_Click(object sender, EventArgs e)
        {
            // Recorre los 3 renglones y las 3 columnas.
            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 3; j++)
                {
                    while (true)
                    {
                        // Pide una venta.
                        string dato = Interaction.InputBox(
                            "Escribe la venta de [" + i + "," + j + "]",
                            "Matriz de ventas");

                        // Si está vacío, termina la captura.
                        if (dato == "")
                        {
                            MessageBox.Show("Captura cancelada.");
                            return;
                        }

                        int venta;

                        // Comprueba que sea un número entero.
                        if (int.TryParse(dato, out venta))
                        {
                            ventas[i, j] = venta;
                            break;
                        }

                        // Si no es un número, lo vuelve a pedir.
                        MessageBox.Show("Escribe solamente números enteros.");
                    }
                }
            }

            // Muestra el botón de imprimir.
            button2.Visible = true;
            MessageBox.Show("Ventas guardadas correctamente.");
        }

        // BOTÓN 2: muestra las ventas.
        private void button2_Click(object sender, EventArgs e)
        {
            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 3; j++)
                {
                    MessageBox.Show(
                        "Venta: " + ventas[i, j],
                        "Posición [" + i + "," + j + "]");
                }
            }
        }

        // BOTÓN 3: cierra el programa.
        private void button3_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
